{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Overly Permissive IAM Policy in JSON format",
  "Resources": {
    "OverlyPermissivePolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "FullAdminPolicy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "*",
              "Resource": "*"
            }
          ]
        },
        "Roles": ["AppExecutionRole"]
      }
    }
  }
}
