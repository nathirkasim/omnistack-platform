{
  "resource": {
    "aws_security_group_rule": {
      "open_ssh": {
        "type": "ingress",
        "from_port": 22,
        "to_port": 22,
        "protocol": "tcp",
        "security_group_id": "sg-0123456789abcdef0",
        "cidr_blocks": ["0.0.0.0/0"]
      },
      "internal_ssh": {
        "type": "ingress",
        "from_port": 22,
        "to_port": 22,
        "protocol": "tcp",
        "security_group_id": "sg-0123456789abcdef0",
        "cidr_blocks": ["10.0.0.0/8"]
      }
    },
    "aws_ebs_volume": {
      "data_volume": {
        "availability_zone": "us-east-1a",
        "size": 50,
        "encrypted": true
      }
    }
  }
}
