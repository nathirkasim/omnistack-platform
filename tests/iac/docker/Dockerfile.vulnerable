# ==============================================================================
# TP-IAC-007: Insecure Dockerfile Configuration
# Issues: Unpinned latest base, running as root, unsafe curl pipe to bash
# ==============================================================================
FROM ubuntu:latest

# Installs as root and pipes untrusted URL to shell
RUN apt-get update && apt-get install -y curl && \
    curl -sSL https://install.example.org/installer.sh | bash

WORKDIR /app
COPY . /app

# Missing USER directive -> executes as root
CMD ["./run.sh"]
