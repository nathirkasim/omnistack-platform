{
  "name": "omniflow/crm-enterprise",
  "description": "OmniFlow Enterprise Customer Relationship & Predictive Revenue Analytics Platform",
  "keywords": ["crm", "analytics", "enterprise", "lead-scoring", "billing"],
  "homepage": "https://omniflow-crm.internal.corp",
  "type": "project",
  "license": "proprietary",
  "authors": [
    {
      "name": "Platform Engineering Team",
      "email": "engineering@omniflow.internal"
    }
  ],
  "require": {
    "php": ">=8.2.0",
    "ext-pdo": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "symfony/http-foundation": "^6.4.4",
    "doctrine/dbal": "^3.8.2",
    "twig/twig": "^3.10.0",
    "monolog/monolog": "^3.5.0",
    "vlucas/phpdotenv": "^5.6.0",
    "predis/predis": "^2.2.2",
    "guzzlehttp/guzzle": "^7.8.1",
    "ramsey/uuid": "^4.7.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.15",
    "mockery/mockery": "^1.6.9",
    "fakerphp/faker": "^1.23.1"
  },
  "autoload": {
    "psr-4": {
      "OmniFlow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OmniFlow\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php -l src/"
  }
}
